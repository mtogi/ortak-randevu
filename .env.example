# Copy to .env.local and fill in. Never commit real values.
# Full reference: docs/architecture/ENV.md

# --- Used by the current scaffold -------------------------------------------
# Public origin of this deployment. Used for absolute links in emails later.
APP_URL="http://localhost:3000"

# --- Wired in M1.5 (ADR-003) -------------------------------------------------
# Postgres connection string for Prisma (`npm run db:migrate:dev`, app runtime).
# Local dev: point at your own local Postgres. Production: Neon, EU / Frankfurt.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Wired in M2a (ADR-004) --------------------------------------------------
# Auth.js session signing, and the HMAC that signs guest booking-management
# links (ADR-005). Required for `next build` / production. Rotating this
# invalidates every outstanding booking link.
# Generate with: npx auth secret
# AUTH_SECRET=""

# Optional SMTP fallback, used only when RESEND_API_KEY is unset. Unset both
# locally and the magic link is logged instead of emailed.
# AUTH_EMAIL_SERVER="smtp://user:pass@localhost:1025"
# AUTH_EMAIL_FROM="Ortak Randevu <noreply@localhost>"

# --- Wired in M2c (ADR-005) --------------------------------------------------
# Resend sends booking mail AND magic links (Q-T14). EMAIL_FROM must be a
# domain verified in Resend. APP_URL above is used for links inside emails.
# RESEND_API_KEY=""
# EMAIL_FROM="Ortak Randevu <no-reply@example.com>"
